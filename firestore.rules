rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Koleksi dokumen pengguna
    match /users/{userId} {
      // Hanya pemilik akun yang dapat mengakses dan memodifikasi datanya
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Seluruh sub-koleksi milik pengguna
      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
