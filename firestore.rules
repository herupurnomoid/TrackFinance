rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function untuk memverifikasi kepemilikan dokumen pengguna
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Koleksi dokumen pengguna
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Subkoleksi Kategori (CAT-12: Strict validation & isLocked protection)
      match /categories/{categoryId} {
        // Hanya pemilik akun yang dapat membaca
        allow read: if isOwner(userId);

        // Validasi pembuatan & pembaruan data kategori
        allow create, update: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 50
          && request.resource.data.isExpense is bool
          && request.resource.data.iconCode is int
          && request.resource.data.color is int;

        // Kategori dengan isLocked == true DILARANG keras dihapus
        allow delete: if isOwner(userId)
          && (!('isLocked' in resource.data) || resource.data.isLocked == false);
      }

      // Subkoleksi Transaksi (TX-14: Strict validation & monetary integrity)
      match /transactions/{transactionId} {
        // Hanya pemilik akun yang dapat membaca dokumen transaksi
        allow read: if isOwner(userId);

        // Validasi pembuatan & pembaruan transaksi
        allow create, update: if isOwner(userId)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && (request.resource.data.type == 'expense' || request.resource.data.type == 'income')
          && request.resource.data.categoryId is string
          && request.resource.data.date is timestamp;

        // Hanya pemilik akun yang dapat menghapus transaksi
        allow delete: if isOwner(userId);
      }

      // Subkoleksi Ringkasan Bulanan (TX-14: Aggregated Cashflow Summaries)
      match /monthly_summaries/{monthKey} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Subkoleksi lainnya milik pengguna (selain categories, transactions, & monthly_summaries)
      match /{subcollection}/{document} {
        allow read, write: if isOwner(userId)
          && subcollection != 'categories'
          && subcollection != 'transactions'
          && subcollection != 'monthly_summaries';
      }
    }
  }
}
